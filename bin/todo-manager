#!/usr/bin/env python3
"""Run the todo-manager CLI from a source checkout (no installation needed).

Runtime data goes to $TODO_HOME (default ~/.hermes/workspace/todo-manager), never here.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from todo_manager.cli import main  # noqa: E402

sys.exit(main())
